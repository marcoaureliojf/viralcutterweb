# --- Git Ignore File for ViralCutter Project ---

# 1. Pastas de Mídia Geradas e Temporárias
# Estas pastas contêm arquivos grandes ou temporários que não devem ser versionados.
/uploads/
/outputs/
/tmp/
/subs/
/subs_ass/
/burned_sub/
/final/
/node_modules/
/papo-de-preta/

# 2. Sistema de Projetos
# Diretório de projetos contém uploads, outputs e arquivos temporários por projeto
/projects/*/uploads/
/projects/*/outputs/
/projects/*/tmp/
/projects/*/burned_sub/
/projects/*/subs_ass/
# Mantém a estrutura de diretórios de projetos, mas ignora o conteúdo
!projects/.gitkeep

# 3. Banco de Dados
# Arquivos de banco de dados SQLite (contém dados locais)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# 4. Antigravity Brain (Artifacts do Assistente)
# Diretório usado pelo assistente de IA para armazenar artefatos
.gemini/

# 5. Arquivos de Ambiente
# NUNCA cometa arquivos .env! Eles contêm chaves de API, senhas e outros segredos.
# É uma boa prática ter um .env.example com a estrutura, mas sem os valores.
*.env
.env*
!.env.example

# 6. Ambientes Virtuais do Python
# A pasta do ambiente virtual é específica da máquina e pode ser muito grande.
# As dependências devem ser gerenciadas pelo requirements.txt.
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 7. Bytecode e Cache do Python
# O Python gera esses arquivos automaticamente para acelerar a execução.
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyz
*.pyw

# 8. Configuração de IDE / Editor de Código
# As configurações do editor são pessoais e não devem ser compartilhadas no repositório.
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 9. Arquivos de Teste e Cobertura
# Relatórios e caches gerados durante os testes.
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# 10. Artefatos de Build e Distribuição
# Gerados ao empacotar a aplicação Python.
build/
dist/
*.egg-info/
*.egg

# 11. Arquivos de Log
# Logs gerados durante a execução da aplicação.
*.log
logs/

# 12. Arquivos específicos do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini